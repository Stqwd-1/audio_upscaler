<Window x:Class="AudioUpscaler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Upscaler" Height="600" Width="800"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#74C7EC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DarkLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Audio Upscaler" FontSize="28" FontWeight="Bold"
                   Foreground="#89B4FA" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Input & Settings -->
            <StackPanel Grid.Column="0" Background="#181825" CornerRadius="8" Padding="16">
                <Label Content="Input File" Style="{StaticResource DarkLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="InputPath" Style="{StaticResource DarkTextBox}"
                             IsReadOnly="True" Text="No file selected..."/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource DarkButton}"
                            Click="BrowseInput_Click"/>
                </Grid>

                <Label Content="Checkpoint" Style="{StaticResource DarkLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="CheckpointPath" Style="{StaticResource DarkTextBox}"
                             Text="checkpoints\best_model.pt"/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource DarkButton}"
                            Click="BrowseCheckpoint_Click"/>
                </Grid>

                <Label Content="Output Directory" Style="{StaticResource DarkLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="OutputDir" Style="{StaticResource DarkTextBox}"
                             Text="outputs"/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource DarkButton}"
                            Click="BrowseOutput_Click"/>
                </Grid>

                <Label Content="Target Sample Rate" Style="{StaticResource DarkLabel}"/>
                <ComboBox x:Name="TargetRate" Style="{StaticResource DarkTextBox}"
                          SelectedIndex="0" Margin="0,0,0,12">
                    <ComboBoxItem Content="96,000 Hz"/>
                    <ComboBoxItem Content="192,000 Hz"/>
                    <ComboBoxItem Content="384,000 Hz"/>
                </ComboBox>

                <Label Content="Quantization" Style="{StaticResource DarkLabel}"/>
                <ComboBox x:Name="QuantizeMode" Style="{StaticResource DarkTextBox}"
                          SelectedIndex="0" Margin="0,0,0,12">
                    <ComboBoxItem Content="None (FP32)"/>
                    <ComboBoxItem Content="INT8 (Dynamic)"/>
                    <ComboBoxItem Content="FP16"/>
                </ComboBox>
            </StackPanel>

            <!-- Right Panel: Options & Progress -->
            <StackPanel Grid.Column="2" Background="#181825" CornerRadius="8" Padding="16">
                <Label Content="Processing Options" Style="{StaticResource DarkLabel}" FontWeight="SemiBold"/>

                <CheckBox x:Name="UseQC" Content="Quality Controller (Judge-Jury-Executioner)"
                          Foreground="#CDD6F4" Margin="0,8" IsChecked="False"/>
                <Grid Margin="20,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Candidates:" Style="{StaticResource DarkLabel}"/>
                    <Slider Grid.Column="1" x:Name="CandidateCount" Minimum="2" Maximum="10"
                            Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </Grid>
                <Grid Margin="20,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Min Agreement:" Style="{StaticResource DarkLabel}"/>
                    <Slider Grid.Column="1" x:Name="MinAgreement" Minimum="0.3" Maximum="1.0"
                            Value="0.7" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                </Grid>

                <CheckBox x:Name="UseTTA" Content="TTA (Phase Inversion Averaging)"
                          Foreground="#CDD6F4" Margin="0,4" IsChecked="False"/>

                <Label Content="Transient Restoration" Style="{StaticResource DarkLabel}" Margin="0,12,0,0"/>
                <Grid Margin="20,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="1" x:Name="TransientStrength" Minimum="0.0" Maximum="1.0"
                            Value="0.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" x:Name="TransientValue" Text="0.0"
                               Foreground="#CDD6F4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Background="#45475A" Margin="0,8"/>

                <Label Content="Status" Style="{StaticResource DarkLabel}" FontWeight="SemiBold"/>
                <TextBox x:Name="StatusText" Style="{StaticResource DarkTextBox}"
                         IsReadOnly="True" TextWrapping="Wrap" Height="60"
                         Text="Ready. Select an input file and click Upscale."/>
            </StackPanel>
        </Grid>

        <!-- Footer: Buttons & Progress -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Grid.Column="0" x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100"
                         Background="#313244" Foreground="#89B4FA" VerticalAlignment="Center" Margin="0,0,16,0"/>

            <Button Grid.Column="1" Content="Upscale" Style="{StaticResource AccentButton}"
                    x:Name="UpscaleBtn" Click="Upscale_Click" Width="140"/>
        </Grid>
    </Grid>
</Window>
